# ==============================================================================
# NXF eSports — Variáveis de Ambiente Públicas (Frontend / Render Static Site)
# ==============================================================================
# ATENÇÃO DE SEGURANÇA:
# Nunca insira segredos de servidor, chaves privadas do Firebase Admin SDK,
# tokens da API do Brawl Stars, secrets de bootstrap ou senhas em variáveis VITE_.
# Em builds estáticos, tudo com prefixo VITE_ torna-se público no bundle.
# ==============================================================================

# URL pública do serviço backend no Render Starter (ex.: https://nxf-esports-api.onrender.com)
# Em desenvolvimento local unificado (tsx server.ts), deixe vazio para usar a mesma origem (/api/*).
VITE_API_BASE_URL=""

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-c6bc6e90-4161-44a5-aa11-a73b7007e787"
VITE_FIREBASE_VAPID_KEY=""
VITE_APP_URL="http://localhost:3000"

# ==============================================================================
# NXF eSports — Variáveis Exclusivas do Backend Express (Render Starter / Local)
# ==============================================================================
# Firebase Admin SDK (escolha UMA das opções abaixo):
# Opção A (recomendada no Render): JSON completo da Service Account (ou Base64)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Opção B: campos individuais da Service Account
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
# Opção C (apenas local): caminho de arquivo JSON
# GOOGLE_APPLICATION_CREDENTIALS="/caminho/seguro/service-account.json"

# Banco Firestore nomeado do projeto Firebase
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-c6bc6e90-4161-44a5-aa11-a73b7007e787"

# Web API Key do projeto Firebase (usada pelo endpoint /api/auth/login-profile no backend)
FIREBASE_WEB_API_KEY=""

# CORS e URL pública do próprio backend (para URLs absolutas de mídia /api/media/:id)
ALLOWED_ORIGINS="https://nxf-esports.onrender.com"
PUBLIC_API_URL="https://nxf-esports-api.onrender.com"

# Bootstrap do PRIMEIRO Administrador Principal (mínimo 12 caracteres).
# Remova ou esvazie esta variável após provisionar o primeiro administrador principal.
BOOTSTRAP_ADMIN_SECRET=""

# API Oficial do Brawl Stars (Supercell)
# Nunca exponha este token no frontend ou em variáveis VITE_.
BRAWL_STARS_API_TOKEN=""

# Opcional: URL de proxy/relay HTTP(S) com IP fixo autorizado na Supercell
# Ex.: https://seu-relay-ip-fixo.exemplo.com/v1
BRAWL_STARS_API_BASE_URL="https://api.brawlstars.com/v1"

# Opcional: diretório persistente para uploads caso anexe Disk no Render Starter
# UPLOAD_DIR="/var/data/nxf-uploads"
